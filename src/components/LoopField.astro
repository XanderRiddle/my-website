---
// PLAN.md §1/§6: thin blue loop lines that draw in behind the cutouts.
// Purely decorative — hidden from assistive tech.
// Every shape carries pathLength="1" so one dash rule drives circles and
// lines alike regardless of their real geometry.
---

<svg
	class="loops"
	viewBox="0 0 1440 900"
	preserveAspectRatio="xMidYMid slice"
	aria-hidden="true"
	focusable="false"
>
	<g class="draw" fill="none" stroke-linecap="round">
		<circle class="s1" pathLength="1" cx="742" cy="606" r="252" stroke="var(--blue)" stroke-width="1.25" opacity="0.5" />
		<circle class="s2" pathLength="1" cx="1064" cy="430" r="386" stroke="var(--blue-dim)" stroke-width="1.5" />
		<circle class="s3" pathLength="1" cx="286" cy="238" r="126" stroke="var(--blue-dim)" stroke-width="1.25" />
		<line class="s4" pathLength="1" x1="0" y1="792" x2="1440" y2="792" stroke="var(--blue-dim)" stroke-width="1" />
		<line class="s5" pathLength="1" x1="418" y1="0" x2="418" y2="900" stroke="var(--blue-dim)" stroke-width="1" />
		<circle class="s6" pathLength="1" cx="418" cy="792" r="9" stroke="var(--blue)" stroke-width="1.5" />
		<circle class="s7" pathLength="1" cx="286" cy="112" r="6" stroke="var(--blue)" stroke-width="1.5" />
	</g>
</svg>

<style>
	.loops {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
		pointer-events: none;
	}

	@keyframes draw-in {
		from {
			stroke-dashoffset: 1;
		}
		to {
			stroke-dashoffset: 0;
		}
	}

	.draw > * {
		stroke-dasharray: 1;
		stroke-dashoffset: 1;
		animation: draw-in 1.2s ease-out var(--delay-loops) forwards;
	}

	/* Slight cascade so the field assembles rather than snapping in at once. */
	.s2 { animation-delay: calc(var(--delay-loops) + 0.1s); }
	.s3 { animation-delay: calc(var(--delay-loops) + 0.18s); }
	.s4 { animation-delay: calc(var(--delay-loops) + 0.26s); }
	.s5 { animation-delay: calc(var(--delay-loops) + 0.32s); }
	.s6 { animation-delay: calc(var(--delay-loops) + 0.6s); }
	.s7 { animation-delay: calc(var(--delay-loops) + 0.68s); }

	/* PLAN.md §10: render already-drawn instead of animating. */
	@media (prefers-reduced-motion: reduce) {
		.draw > * {
			animation: none;
			stroke-dashoffset: 0;
		}
	}
</style>
