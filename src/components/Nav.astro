---
// PLAN.md §3: home icon · section links · social icons.
// Social hrefs are placeholders — swap the "#" values for real profile URLs.
const links = [
	{ href: "/about", label: "About" },
	{ href: "/projects", label: "Projects" },
	{ href: "/skills", label: "Skills" },
	{ href: "/experience", label: "Experience" },
	{ href: "/education", label: "Education" },
	{ href: "/contact", label: "Contact" },
];

const socials = [
	{ href: "#", label: "Instagram", icon: "instagram" },
	{ href: "#", label: "GitHub", icon: "github" },
	{ href: "#", label: "LinkedIn", icon: "linkedin" },
	{ href: "mailto:xriddle0917@gmail.com", label: "Email", icon: "email" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="nav">
	<a class="home" href="/" aria-label="Home" aria-current={path === "/" ? "page" : undefined}>
		<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
			<path d="M3 10.5 12 3l9 7.5" />
			<path d="M5.5 9.5V20h13V9.5" />
		</svg>
	</a>

	<nav aria-label="Primary">
		<ul>
			{
				links.map(({ href, label }) => (
					<li>
						<a href={href} aria-current={path === href ? "page" : undefined}>
							{label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>

	<ul class="socials">
		{
			socials.map(({ href, label, icon }) => (
				<li>
					<a href={href} aria-label={label} rel={href.startsWith("http") ? "noopener noreferrer" : undefined} target={href.startsWith("http") ? "_blank" : undefined}>
						<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
							{icon === "instagram" && (
								<Fragment>
									<rect x="3" y="3" width="18" height="18" rx="5" />
									<circle cx="12" cy="12" r="4" />
									<circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none" />
								</Fragment>
							)}
							{icon === "github" && (
								<path d="M9 19c-4.3 1.4-4.3-2.2-6-2.6m12 4.6v-3.6a3.1 3.1 0 0 0-.9-2.4c2.9-.3 6-1.4 6-6.4a4.9 4.9 0 0 0-1.4-3.4 4.6 4.6 0 0 0-.1-3.4S17.4 1 15 2.7a12.3 12.3 0 0 0-6.4 0C6.2 1 5.2 1.8 5.2 1.8a4.6 4.6 0 0 0-.1 3.4A4.9 4.9 0 0 0 3.7 8.6c0 5 3.1 6.1 6 6.4a3.1 3.1 0 0 0-.9 2.4V21" />
							)}
							{icon === "linkedin" && (
								<Fragment>
									<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-13h4v1.5A6 6 0 0 1 16 8Z" />
									<rect x="2" y="9" width="4" height="12" />
									<circle cx="4" cy="4" r="2" />
								</Fragment>
							)}
							{icon === "email" && (
								<Fragment>
									<rect x="2.5" y="4.5" width="19" height="15" rx="2.5" />
									<path d="m3 7 9 6 9-6" />
								</Fragment>
							)}
						</svg>
					</a>
				</li>
			))
		}
	</ul>
</header>

<style>
	.nav {
		position: fixed;
		inset: 0 0 auto 0;
		z-index: 50;
		height: var(--nav-height);
		display: flex;
		align-items: center;
		gap: clamp(1rem, 3vw, 2.5rem);
		padding-inline: var(--page-gutter);
		background: transparent;
	}

	ul {
		display: flex;
		align-items: center;
		list-style: none;
		padding: 0;
	}

	nav {
		margin-inline: auto;
	}

	nav ul {
		gap: clamp(0.75rem, 2vw, 2rem);
	}

	nav a {
		font-size: 0.9375rem;
		color: var(--text-muted);
		transition: color 180ms ease-out;
	}

	nav a:hover,
	nav a[aria-current="page"] {
		color: var(--text);
	}

	.home,
	.socials a {
		display: grid;
		place-items: center;
		color: var(--text-muted);
		transition: color 180ms ease-out;
	}

	.home:hover,
	.socials a:hover {
		color: var(--blue);
	}

	.home svg {
		width: 1.5rem;
		height: 1.5rem;
	}

	.socials {
		gap: 1rem;
	}

	.socials svg {
		width: 1.25rem;
		height: 1.25rem;
	}

	/* Below the desktop breakpoint the six section links wrap under the
	   icon row rather than squeezing the hero. */
	@media (max-width: 767px) {
		.nav {
			height: auto;
			flex-wrap: wrap;
			row-gap: 0.5rem;
			padding-block: 0.875rem;
			background: color-mix(in srgb, var(--bg-panel) 85%, transparent);
			backdrop-filter: blur(8px);
		}

		nav {
			order: 3;
			flex-basis: 100%;
			margin-inline: 0;
		}

		nav ul {
			flex-wrap: wrap;
			justify-content: center;
			gap: 0.5rem 1rem;
		}

		nav a {
			font-size: 0.875rem;
		}

		.socials {
			margin-inline-start: auto;
		}
	}
</style>
