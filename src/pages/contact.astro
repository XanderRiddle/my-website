---
import Layout from "../layouts/Layout.astro";

// Icon paths mirror Nav.astro's social set so the same mark reads the same
// way in the top bar and here.
const links = [
	{
		href: "mailto:xriddle0917@gmail.com",
		label: "Email",
		sub: "xriddle0917@gmail.com",
		icon: "email",
	},
	{
		href: "https://www.linkedin.com/in/xanderriddle/",
		label: "LinkedIn",
		sub: "/in/xanderriddle",
		icon: "linkedin",
	},
	{
		href: "https://github.com/XanderRiddle",
		label: "GitHub",
		sub: "@XanderRiddle",
		icon: "github",
	},
	{
		href: "https://www.instagram.com/xander._.riddle/",
		label: "Instagram",
		sub: "@xander._.riddle",
		icon: "instagram",
	},
];
---

<Layout
	title="Contact — Xander Riddle"
	description="Get in touch with Xander Riddle — open for full-time or internship robotics and software roles, or just to talk shop."
>
	<section class="contact">
		<header class="intro float-up">
			<h1>Contact</h1>
			<p class="subtitle">
				Open for work, full time or internship, or just to talk about robotics.
			</p>
		</header>

		<a
			class="resume float-up"
			style="--delay: 0.1s"
			href="/resume.pdf"
			download="Xander-Riddle-Resume.pdf"
			type="application/pdf"
		>
			<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
				<path d="M12 3v12" />
				<path d="m7.5 10.5 4.5 4.5 4.5-4.5" />
				<path d="M4.5 18.5V20a1 1 0 0 0 1 1h13a1 1 0 0 0 1-1v-1.5" />
			</svg>
			Download Resume
		</a>

		<ul class="links">
			{
				links.map(({ href, label, sub, icon }, i) => (
					<li class="float-up" style={`--delay: ${0.16 + i * 0.06}s`}>
						<a
							href={href}
							rel={href.startsWith("http") ? "noopener noreferrer" : undefined}
							target={href.startsWith("http") ? "_blank" : undefined}
						>
							<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
								{icon === "linkedin" && (
									<Fragment>
										<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-13h4v1.5A6 6 0 0 1 16 8Z" />
										<rect x="2" y="9" width="4" height="12" />
										<circle cx="4" cy="4" r="2" />
									</Fragment>
								)}
								{icon === "instagram" && (
									<Fragment>
										<rect x="3" y="3" width="18" height="18" rx="5" />
										<circle cx="12" cy="12" r="4" />
										<circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none" />
									</Fragment>
								)}
								{icon === "github" && (
									<path d="M9 19c-4.3 1.4-4.3-2.2-6-2.6m12 4.6v-3.6a3.1 3.1 0 0 0-.9-2.4c2.9-.3 6-1.4 6-6.4a4.9 4.9 0 0 0-1.4-3.4 4.6 4.6 0 0 0-.1-3.4S17.4 1 15 2.7a12.3 12.3 0 0 0-6.4 0C6.2 1 5.2 1.8 5.2 1.8a4.6 4.6 0 0 0-.1 3.4A4.9 4.9 0 0 0 3.7 8.6c0 5 3.1 6.1 6 6.4a3.1 3.1 0 0 0-.9 2.4V21" />
								)}
								{icon === "email" && (
									<Fragment>
										<rect x="2.5" y="4.5" width="19" height="15" rx="2.5" />
										<path d="m3 7 9 6 9-6" />
									</Fragment>
								)}
							</svg>

							<span class="text">
								<span class="label">{label}</span>
								<span class="sub">{sub}</span>
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Layout>

<style>
	.contact {
		max-width: 34rem;
		margin-inline: auto;
		padding: calc(var(--nav-height) + 3.5rem) var(--page-gutter) 5rem;
	}

	.intro {
		margin-bottom: 2.25rem;
	}

	h1 {
		font-size: clamp(2.25rem, 5vw, 3.5rem);
		letter-spacing: -0.02em;
	}

	.subtitle {
		margin-top: 0.75rem;
		max-width: 32ch;
		color: var(--text-muted);
		font-size: clamp(0.9375rem, 1.2vw, 1.0625rem);
	}

	/* Same pill as the résumé download on /about. */
	.resume {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.75rem 1.5rem;
		border: 1px solid var(--blue-dim);
		border-radius: 999px;
		background: color-mix(in srgb, var(--blue) 12%, transparent);
		font-family: var(--font-display);
		font-size: 0.9375rem;
		font-weight: 500;
		color: var(--text);
		transition:
			border-color 200ms ease-out,
			background-color 200ms ease-out;
	}

	.resume svg {
		width: 1.125rem;
		height: 1.125rem;
		transition: transform 200ms ease-out;
	}

	.resume:hover {
		border-color: var(--blue);
		background: color-mix(in srgb, var(--blue) 22%, transparent);
	}

	.resume:hover svg {
		transform: translateY(2px);
	}

	.links {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin-top: 2.5rem;
		padding: 0;
		list-style: none;
	}

	.links a {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 1rem 1.25rem;
		border: 1px solid var(--blue-dim);
		border-radius: 14px;
		background: var(--bg-panel);
		transition:
			border-color 200ms ease-out,
			background-color 200ms ease-out;
	}

	.links a:hover {
		border-color: var(--blue);
		background: color-mix(in srgb, var(--blue) 8%, var(--bg-panel));
	}

	.links svg {
		flex-shrink: 0;
		width: 1.375rem;
		height: 1.375rem;
		color: var(--blue);
	}

	.text {
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
	}

	.label {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.9375rem;
		color: var(--text);
	}

	.sub {
		font-size: 0.8125rem;
		color: var(--text-muted);
	}

	@media (max-width: 767px) {
		.contact {
			padding-top: calc(var(--nav-height) + 5rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.resume svg {
			transition: none;
		}

		.resume:hover svg {
			transform: none;
		}
	}
</style>
