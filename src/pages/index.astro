---
import Layout from "../layouts/Layout.astro";
import LoopField from "../components/LoopField.astro";
import IntroText from "../components/IntroText.astro";
import Portrait from "../components/Portrait.astro";
---

<Layout title="Xander Riddle — Engineer & Project Manager">
	<section class="hero">
		<LoopField />

		<div class="zone zone-text">
			<IntroText />
		</div>

		<div class="zone zone-portrait">
			<Portrait />
		</div>
	</section>
</Layout>

<style>
	.hero {
		position: relative;
		min-height: 100svh;
		/* Where the portrait's centre line falls. LoopField re-centres its
		   rings on this, and it changes with the stacked layout below. */
		--portrait-cx: 70vw;
		/* Scoped to the hero so the portrait's bottom crop never introduces a
		   page-level scrollbar (PLAN.md §3). */
		overflow: hidden;
	}

	.zone {
		position: absolute;
		z-index: 10;
	}

	/* Desktop two-zone layout — PLAN.md §5. Text owns the left ~40vw; the
	   portrait owns the rest. */
	.zone-text {
		left: var(--page-gutter);
		top: 50%;
		transform: translateY(-50%);
		/* The zone reaches the 40vw boundary; IntroText caps its own line
		   length well inside it rather than filling the whole column. */
		width: calc(40vw - var(--page-gutter));
	}

	/* Centred within the right zone rather than pinned to the far edge, so the
	   loop lines read on both sides of him (PLAN.md §5). */
	.zone-portrait {
		left: 40vw;
		right: 0;
		bottom: 0;
		height: 90svh;
		/* Portrait sizes its own height so the derived width stays inside
		   this zone; it needs to know how wide the zone is. */
		--zone-w: 60vw;
		display: flex;
		align-items: flex-end;
		justify-content: center;
	}

	/* Stacked layout — PLAN.md §5. Text on top, portrait centred below. */
	@media (max-width: 767px) {
		.hero {
			/* Single source of truth for the stacked layout: the reserved band
			   below the copy and the portrait's height derive from the same
			   value, so they can't drift apart and collide. */
			--stage-h: 50svh;
			/* Stacked: the portrait spans the full width, so its centre line
			   moves to the middle and the loop field follows it. */
			--portrait-cx: 50vw;
			display: flex;
			flex-direction: column;
			padding-top: calc(var(--nav-height) + 4.5rem);
		}

		.zone-text {
			position: static;
			width: 100%;
			transform: none;
			padding-inline: var(--page-gutter);
		}

		/* Reserve the band the portrait occupies so it never overlaps the copy. */
		.hero::after {
			content: "";
			display: block;
			flex: 1 0 var(--stage-h);
		}

		/* Kept shorter than the reserved band so the crop stays at the hero's
		   bottom edge without eating into the copy. */
		.zone-portrait {
			left: 0;
			--zone-w: 100vw;
			height: calc(var(--stage-h) - 4svh);
		}
	}
</style>
