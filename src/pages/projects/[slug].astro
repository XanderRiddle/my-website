---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths } from "astro";
import Layout from "../../layouts/Layout.astro";
import TagBubble from "../../components/projects/TagBubble.astro";

// PLAN-projects.md §7 step 7 — starts as title + description + tags + hero
// shot; the markdown body of each entry is rendered below once written, and a
// photo gallery slots in after that.
export const getStaticPaths: GetStaticPaths = async () => {
	const projects = await getCollection("projects");
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
};

interface Props {
	project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, thumbnail, description, tags } = project.data;
const { Content } = await render(project);
// Every entry currently ships with only an HTML-comment placeholder in its
// body (see e.g. content/projects/spii.md) — strip comments before
// checking, or that placeholder itself counts as "content" and the pending
// message below never shows.
const hasBody = Boolean(project.body?.replace(/<!--[\s\S]*?-->/g, "").trim());
---

<Layout title={`${title} — Xander Riddle`} description={description}>
	<article class="project">
		<a class="back" href="/projects">← All projects</a>

		<header class="head float-up">
			<h1>{title}</h1>
			<p class="description">{description}</p>
			<ul class="tags">
				{
					tags.map((tag) => (
						<li>
							<TagBubble tag={tag} />
						</li>
					))
				}
			</ul>
		</header>

		<div class="shot float-up" style="--delay:0.15s">
			<Image
				src={thumbnail}
				alt={`${title} project thumbnail`}
				widths={[...new Set([720, Math.min(1120, thumbnail.width)])]}
				sizes="(max-width: 767px) 92vw, 60rem"
				format="webp"
				loading="eager"
				fetchpriority="high"
			/>
		</div>

		{
			hasBody ? (
				<div class="body">
					<Content />
				</div>
			) : (
				<p class="pending">
					A full write-up and photo gallery for this project are on the way.
				</p>
			)
		}
	</article>
</Layout>

<style>
	.project {
		max-width: 60rem;
		margin-inline: auto;
		padding: calc(var(--nav-height) + 3rem) var(--page-gutter) 5rem;
	}

	.back {
		display: inline-block;
		margin-bottom: 1.75rem;
		color: var(--text-muted);
		font-size: 0.9375rem;
		transition: color 180ms ease-out;
	}

	.back:hover {
		color: var(--blue);
	}

	h1 {
		font-size: clamp(2.25rem, 5vw, 3.5rem);
		letter-spacing: -0.02em;
	}

	.description {
		margin-top: 0.75rem;
		max-width: 42rem;
		color: var(--text-muted);
		font-size: 1.0625rem;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4375rem;
		margin-top: 1.25rem;
		padding: 0;
		list-style: none;
	}

	.shot {
		margin-top: 2.5rem;
		border-radius: 16px;
		overflow: hidden;
		border: 1px solid var(--blue-dim);
		background: var(--bg-panel);
	}

	.shot :global(img) {
		width: 100%;
		height: auto;
	}

	.pending {
		margin-top: 2.5rem;
		max-width: 44rem;
		color: var(--text-muted);
	}

	/* Prose (headings, paragraphs, lists) stays readable-width; embedded media
	   — galleries, the BOM table, the match video — is free to run the full
	   article width (60rem, matching .shot above). */
	.body {
		margin-top: 2.5rem;
		color: var(--text-muted);
	}

	.body :global(h2),
	.body :global(h3),
	.body :global(p),
	.body :global(ul),
	.body :global(ol) {
		max-width: 44rem;
	}

	.body :global(h2) {
		margin-top: 2.5rem !important;
		color: var(--text);
		font-size: 1.5rem;
	}

	.body :global(h3) {
		margin-top: 1.75rem !important;
		color: var(--text);
		font-size: 1.1875rem;
	}

	.body :global(p + p) {
		margin-top: 1rem;
	}

	.body :global(ul),
	.body :global(ol) {
		margin-top: 1rem;
		padding-left: 1.25rem;
	}

	.body :global(li + li) {
		margin-top: 0.375rem;
	}

	.body :global(ul + p),
	.body :global(ol + p) {
		margin-top: 1.25rem;
	}

	.body :global(a) {
		color: var(--blue);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	/* Full-width media blocks (gallery, BOM table, match video) that a
	   project write-up drops into the prose flow — spaced like a heading. */
	.body :global(.media),
	.body :global(.gallery) {
		margin-top: 2.25rem;
	}

	.body :global(.table-wrap) {
		overflow-x: auto;
	}

	.body :global(table) {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.9375rem;
	}

	.body :global(th),
	.body :global(td) {
		padding: 0.625rem 0.875rem;
		text-align: left;
		border-bottom: 1px solid var(--blue-dim);
		white-space: nowrap;
	}

	.body :global(th) {
		color: var(--text);
		font-family: var(--font-display);
		font-weight: 500;
	}

	.body :global(tfoot td) {
		color: var(--text);
		font-weight: 600;
		border-bottom: none;
	}

	.body :global(video) {
		width: 100%;
		height: auto;
		border-radius: 16px;
		border: 1px solid var(--blue-dim);
		background: var(--bg-panel);
	}

	.body :global(figure) {
		margin: 0;
	}

	.body :global(figcaption) {
		margin-top: 0.625rem;
		color: var(--text-muted);
		font-size: 0.875rem;
		text-align: center;
	}

	@media (max-width: 767px) {
		.project {
			padding-top: calc(var(--nav-height) + 4.5rem);
		}
	}
</style>
